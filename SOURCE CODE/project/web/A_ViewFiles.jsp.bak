          <h2>Files </h2>
          <p>&nbsp;</p>
          <table width="623" border="1.5" style="border-collapse:collapse" cellpadding="0" cellspacing="0"  align="center">
            <%	  
			  
			  
	String s1="",s2="",s3="",s4="",s5="",s6="",s7="",s8,s9="",s10,s11,s12,s13;
	int i=0,j=0,k=0;
try 
	{		
		
				%>
            <tr>
              <td width="38" height="30" bgcolor="#FFFF00"><div align="center" class="style33"> ID </div></td>
              <td width="94" bgcolor="#FFFF00"><div align="center" class="style33">File Name </div></td>
              <td width="103" bgcolor="#FFFF00"><div align="center" class="style33">Data Owner </div></td>
              <td width="173" bgcolor="#FFFF00"><div align="center" class="style33">Content Key</div></td>
              <td width="112" bgcolor="#FFFF00"><div align="center" class="style33">Secret Key</div></td>
              <td width="89" bgcolor="#FFFF00"><div align="center" class="style33">View </div></td>
            </tr>
            <%
				
				
				String query="Select *from cloudserver "; 
				Statement st=connection.createStatement();
				ResultSet rs=st.executeQuery(query);
				while ( rs.next() )
				{
					i=rs.getInt(1);
					s2=rs.getString(2);
					s3=rs.getString(8);
					s4=rs.getString(4);
					s5=rs.getString(5);
					
					String keys = "ef50a0ef2c3e3a5f";
					byte[] keyValue = keys.getBytes();
					Key key = new SecretKeySpec(keyValue, "AES");
					Cipher c = Cipher.getInstance("AES");
					c.init(Cipher.DECRYPT_MODE, key);
					String dt1 = new String(Base64.decode(s3.getBytes()));
					
					%>
            <tr>
              <td height="28"><div align="center"><%=i%></div></td>
              <td><div align="center"><%=s2%></div></td>
              <td><div align="center"><a href="A_OwnerDetails.jsp?dname=<%=s3%>"><%=s3%></a></div></td>
              <td><div align="center"><%=s4%></div></td>
              <td><div align="center"><%=s5%></div></td>
              <td><div align="center"><a href="A_FileDetails.jsp?usid=<%=i%>">View More ...</a></div></td>
            </tr>
            <%
				}
	connection.close();
	}
	catch(Exception e)
	{
	out.println(e.getMessage());
	}
%>
