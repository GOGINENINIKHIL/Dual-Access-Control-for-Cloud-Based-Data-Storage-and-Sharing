          <h2><span> Added  </span> File</h2>
          <p>&nbsp;</p>
          <p>
            <%

	try 
	{
	
	String filename=request.getParameter("t42");
      		String file=request.getParameter("tt");
      		String cont=request.getParameter("text");
			
		
		String dname=(String)application.getAttribute("doname");
		
		
		
		SimpleDateFormat sdfDate = new SimpleDateFormat("dd/MM/yyyy");
		SimpleDateFormat sdfTime = new SimpleDateFormat("HH:mm:ss");
		Date now = new Date();
		
		String strDate = sdfDate.format(now);
		String strTime = sdfTime.format(now);
		String dt = strDate + "   " + strTime;
		
		
		
			
		String rank="0";
		
		
		Statement st=connection.createStatement();
		String task="Added File";

		String strQuery2 = "insert into transaction(user,fname,task,dt) values('"+dname+"','"+file+"','"+task+"','"+dt+"')";
		st.executeUpdate(strQuery2);
		String sch="Schedule";
		
		
		st.executeUpdate("insert into  ownerfiles(fname,ct,secretkey,contentkey,rank,dt,downer) values ('"+file+"','"+cont+"','No','No','"+rank+"','"+dt+"','"+dname+"')");
		
		
		%>
</p>
          <h2 class="style30">File Added Sucessfully !!!</h2>
          <p class="style30">&nbsp;</p>
          </p>
          <a href="DO_Main.jsp">Back</a><br />
          <%
		
		
		
		connection.close();
	}
	
	catch(Exception e)
