      <div class="mainbar">
        <div class="article">
          <h2><span>Files</span></h2>
          <p><span class="style22">Role : (<%=application.getAttribute("urole")%>)</span></p>
          <p>&nbsp;</p>
          <table width="421" border="1.5" style="border-collapse:collapse" cellpadding="0" cellspacing="0"  align="center">
            <%	  
			  
			  
	String s1="",s2="",s3="",s4="",s5="",s6="",s7="",s8,s9="",s10,s11,s12,s13;
	int i=0,j=0,k=0;
try 
	{		
		
				%>
            <tr>
              <td width="85" height="30" bgcolor="#FFFF00"><div align="center" class="style35"> ID </div></td>
              <td width="151" bgcolor="#FFFF00"><div align="center" class="style35">File Name </div></td>
              <td width="177" bgcolor="#FFFF00"><div align="center" class="style35">Data Owner </div></td>
            </tr>
            <%
				
			String urole=(String)application.getAttribute("urole");
			String role="";
			if(urole.equalsIgnoreCase("Doctor"))
			{
				role="doctor_per";
			}
			else if(urole.equalsIgnoreCase("Nurse"))
			{
				role="nurse_per";
			}
			else if(urole.equalsIgnoreCase("Cardiologist"))
			{
				role="cardiologist_per";
			}
			else
			{}
			
				String query="Select *from cloudserver "; 
				Statement st=connection.createStatement();
				ResultSet rs=st.executeQuery(query);
				while ( rs.next() )
				{
					s2=rs.getString(2);

					String query1 = "select * from download_perm where fname='"+s2+"' and "+role+"='Permitted'";
					ResultSet rs1 = connection.createStatement().executeQuery(query1);
					if(rs1.next()==true)
					{
						String query2 = "select * from search_perm where fname='"+s2+"' and "+role+"='Permitted'";
						ResultSet rs2 = connection.createStatement().executeQuery(query2);
						if(rs2.next()==true)
						{
							String query3="Select *from cloudserver where fname='"+s2+"'"; 
							Statement st1=connection.createStatement();
							ResultSet rs3=st1.executeQuery(query3);
							if ( rs3.next() )
							{
			
								i=rs3.getInt(1);
								s2=rs3.getString(2);
								s3=rs3.getString(8);
								s4=rs3.getString(9);
								s5=rs3.getString(10);
								
								String keys = "ef50a0ef2c3e3a5f";
								byte[] keyValue = keys.getBytes();
								Key key = new SecretKeySpec(keyValue, "AES");
								Cipher c = Cipher.getInstance("AES");
								c.init(Cipher.DECRYPT_MODE, key);
								String dt1 = new String(Base64.decode(s3.getBytes()));
								
								%>
								<tr>
								<td height="28"><div align="center"><%=i%></div></td>
								<td><div align="center"><%=s2%></div></td>
								<td><div align="center"><a href="DU_OwnerDetails.jsp?dname=<%=s3%>"><%=s3%></a></div></td>
								</tr>
								<%
							}	
						}		
					}			
				}
	connection.close();
	}
	catch(Exception e)
	{
	out.println(e.getMessage());
	}
%>
