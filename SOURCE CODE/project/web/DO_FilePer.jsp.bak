  <div class="content">
    <div class="content_resize">
      <div class="mainbar">
        <div class="article">
          <h2><span>Provide Download &amp; Search Permission  </span></h2>
          <p>&nbsp;</p>
          <table width="816" border="1.5" style="border-collapse:collapse" cellpadding="0" cellspacing="0"  align="center">
            <%	  
			  
			  
	String s1="",s2="",s3="",s4="",s5="",s6="",s7="",s8,s9="",s10,s11,s12,s13;
	int i=0,j=0,k=0;
try 
	{		
		
				%>
            <tr>
              <td width="61" height="30" bgcolor="#FFFF00"><div align="center" class="style33"> ID </div></td>
              <td width="111" bgcolor="#FFFF00"><div align="center" class="style33">File Name </div></td>
              <td width="124" bgcolor="#FFFF00"><div align="center" class="style33">Content Key</div></td>
              <td width="145" bgcolor="#FFFF00"><div align="center" class="style33">Secret Key</div></td>
              <td width="125" bgcolor="#FFFF00"><div align="center" class="style33">Download Per </div></td>
              <td width="125" bgcolor="#FFFF00"><div align="center" class="style33">Search Per </div></td>
            </tr>
            <%
				String dname=(String)application.getAttribute("doname");
				
				String query="Select *from cloudserver where downer='"+dname+"'"; 
				Statement st=connection.createStatement();
				ResultSet rs=st.executeQuery(query);
				while ( rs.next() )
				{
					i=rs.getInt(1);
					s2=rs.getString(2);
					s3=rs.getString(4);
					s4=rs.getString(5);
					s5=rs.getString(9);
					s6=rs.getString(10);
					
					String keys = "ef50a0ef2c3e3a5f";
					byte[] keyValue = keys.getBytes();
					Key key = new SecretKeySpec(keyValue, "AES");
					Cipher c = Cipher.getInstance("AES");
					c.init(Cipher.DECRYPT_MODE, key);
					String dt1 = new String(Base64.decode(s3.getBytes()));
					
					%>
            <tr>
              <td height="28"><div align="center"><%=i%></div></td>
              <td><div align="center"><a href="DO_FileDetails.jsp?usid=<%=i%>"><%=s2%></a></div></td>
              <td><div align="center"><%=s3%></div></td>
              <td><div align="center"><%=s4%></div></td>
			  <%
			  if (s5.equalsIgnoreCase("No"))
			  {
			  %>
              <td><div align="center"><a href="DO_DownPer.jsp?usid=<%=i%>">Provide Permission</a></div></td>
			  <%
			  }
			  else
			  {
			  %>
              <td><div align="center"><%=s5%></div></td>
			  <%
			  }
			   if (s6.equalsIgnoreCase("No"))
			  {
			  %>
              <td><div align="center"><a href="DO_SrchPer.jsp?usid=<%=i%>">Provide Permission</a></div></td>
			  <%
			  }
			  else
			  {
			  %>
              <td><div align="center"><%=s6%></div></td>
			  <%
			  }
			  %>
            </tr>
            <%
				}
	connection.close();
	}
	catch(Exception e)
	{
	out.println(e.getMessage());
	}
%>
          </table>
          <p>&nbsp;</p>
          <table width="816" border="0" cellspacing="0" cellpadding="0">
