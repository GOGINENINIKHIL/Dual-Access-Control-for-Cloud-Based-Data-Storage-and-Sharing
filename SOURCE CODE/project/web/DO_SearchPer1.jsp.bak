<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<%@page import="com.oreilly.servlet.*,java.sql.*,java.lang.*,java.text.SimpleDateFormat,java.util.*,java.io.*,javax.servlet.*,javax.servlet.http.*" %>
<%@ page import="java.sql.*"%>
<%@ include file="connect.jsp" %>
<%@ page import="java.util.Date" %>

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<title>Data Owner </title>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
<link href="style.css" rel="stylesheet" type="text/css" />
<script type="text/javascript" src="js/cufon-yui.js"></script>
<script type="text/javascript" src="js/arial.js"></script>
<script type="text/javascript" src="js/cuf_run.js"></script>
<style type="text/css">
<!--
.style3 {	font-size: 18px;
	font-weight: bold;
}
.style21 {font-size: 14px}
.style22 {color: #666666; font-weight: bold;}
.style5 {font-size: 18px}
.style34 {color: #FF0000; font-size: 24px;}
-->
</style>
</head>
<body>
<div class="main">
  <div class="header">
    <div class="header_resize">
      <div class="logo">
        <h1><a href="index.html" class="style34">Attribute-Based Storage Supporting Secure Deduplication of Encrypted Data in Cloud</a><a href="index.html"></a><a href="index.html"></a><a href="index.html"></a></h1>
      </div>
      <div class="clr"></div>
      <div class="menu_nav">
        <ul>
          <li class="active"><a href="DO_Main.jsp">Data Owner </a></li>
          <li><a href="DO_Login.jsp">Logout</a></li>
        </ul>
      </div>
      <div class="clr"></div>
    </div>
  </div>
  <div class="content">
    <div class="content_resize">
      <div class="mainbar">
        <div class="article">
          <h2><span>Search Permission </span></h2>
          <p>&nbsp;</p>
          <h3>
            <%
					ArrayList list = new ArrayList();
					ServletContext context = getServletContext();
					String dirName =context.getRealPath("Gallery\\");
					String paramname=null;
					String doc_per="No";
					String nur_per="No";
					String cardo_per="No";
					String fname="";
					String id=request.getParameter("id");
			String dname=(String)application.getAttribute("doname");
							Statement st=connection.createStatement();
				
					FileInputStream fs=null;
					try {
							MultipartRequest multi = new MultipartRequest(request, dirName,	10 * 1024 * 1024); // 10MB
							Enumeration params = multi.getParameterNames();
							while (params.hasMoreElements()) 
							{
								paramname = (String) params.nextElement();
								
								if(paramname.equalsIgnoreCase("checkbox"))
								{
								doc_per=multi.getParameter(paramname);
								}
								if(paramname.equalsIgnoreCase("checkbox2"))
								{
								nur_per=multi.getParameter(paramname);
								}		
								if(paramname.equalsIgnoreCase("checkbox3"))
								{
								cardo_per=multi.getParameter(paramname);
								}
								if(paramname.equalsIgnoreCase("fname"))
								{
								fname=multi.getParameter(paramname);
								}
							
							}
						

							
							if((doc_per.equalsIgnoreCase("Permitted"))&& (nur_per.equalsIgnoreCase("Permitted"))&& (cardo_per.equalsIgnoreCase("Permitted")))
							{
							
	st.executeUpdate("update search_perm set doctor_per='"+doc_per+"',nurse_per='"+nur_per+"',cardiologist_per='"+cardo_per+"' where owner='"+dname+"' and fname='"+fname+"'");
			%>
            Permission Granted Sucessfully For Doctor, Nurse And Cardiologist
            <%
	
							}
							else if((doc_per.equalsIgnoreCase("Permitted"))&& (nur_per.equalsIgnoreCase("Permitted")))
							{
							
	st.executeUpdate("update search_perm set doctor_per='"+doc_per+"',nurse_per='"+nur_per+"' where owner='"+dname+"' and fname='"+fname+"'");
		%>
            Permission Granted Sucessfully For Doctor And Nurse
            <%

	
							}
							else if((doc_per.equalsIgnoreCase("Permitted"))&& (cardo_per.equalsIgnoreCase("Permitted")))
							{
							
	st.executeUpdate("update search_perm set doctor_per='"+doc_per+"',cardiologist_per='"+cardo_per+"' where owner='"+dname+"' and fname='"+fname+"'");
		%>
            Permission Granted Sucessfully For Doctor And Cardiologist
            <%

	
							}
							else if(doc_per.equalsIgnoreCase("Permitted"))
							{
							
	st.executeUpdate("update search_perm set doctor_per='"+doc_per+"' where owner='"+dname+"' and fname='"+fname+"'");
		%>
            Permission Granted Sucessfully For Doctor
            <%

	
							}
							else if(cardo_per.equalsIgnoreCase("Permitted"))
							{
							
	st.executeUpdate("update search_perm set cardiologist_per='"+cardo_per+"' where owner='"+dname+"' and fname='"+fname+"'");
		%>
            Permission Granted Sucessfully For Cardiologist
            <%

	
							}
							else if(nur_per.equalsIgnoreCase("Permitted"))
							{
							
	st.executeUpdate("update search_perm set nurse_per='"+nur_per+"' where owner='"+dname+"' and fname='"+fname+"'");
	%>
            Permission Granted Sucessfully For Nurse
            <%
	
							}
							else if((nur_per.equalsIgnoreCase("Permitted"))&& (cardo_per.equalsIgnoreCase("Permitted")))
							{
							
	st.executeUpdate("update search_perm set nurse_per='"+nur_per+"',cardiologist_per='"+cardo_per+"' where owner='"+dname+"' and fname='"+fname+"'");
	%>
            Permission Granted Sucessfully For Nurse And Cardiologist
            <%
	
							}
							else
							{
								%>
            <span class="style5">Select Roles To Grant Permissions !!</span> </h3>
          <%
							
							}
							
							
					} 
					catch (Exception e) 
					{
						out.println(e.getMessage());
						e.printStackTrace();
					}
				%>
<div align="right"><a href="DO_FilePer.jsp">Back</a></div>
        </div>
      </div>
      <div class="clr"></div>
    </div>
  </div>
  <div class="footer">
    <div class="footer_resize">
      <p class="lf">&nbsp;</p>
      <div class="clr"></div>
    </div>
    <div class="clr"></div>
  </div>
</div>
<div align=center></div>
</body>
</html>

