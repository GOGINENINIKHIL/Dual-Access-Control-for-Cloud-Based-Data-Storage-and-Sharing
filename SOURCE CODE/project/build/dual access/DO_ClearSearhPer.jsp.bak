          <p>&nbsp;</p>
 <%

try
	{
		String id=request.getParameter("usid");
		
	
			
			String query="select * from search_perm where id='"+id+"'";
			Statement st1=connection.createStatement();
			ResultSet rs1=st1.executeQuery(query);
			if(rs1.next())
			{
			
				String query2="update search_perm set doctor_per='No', nurse_per='No', cardiologist_per='No' where id='"+id+"' ";
				Statement st2=connection.createStatement();
				st2.executeUpdate(query2);
				
				%>
		  <span class="style5">Retracted Permissions From All Roles !!</span>		  </h3>
								<%
			}
		connection.close();
	}
	catch(Exception e)
	{
	out.println(e);
	}

%>

